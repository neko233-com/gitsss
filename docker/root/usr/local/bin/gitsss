#!/bin/bash

GITSSS="/app/gitsss/gitsss"
WORK_DIR="${GITSSS_CUSTOM:-${GITEA_CUSTOM:-/data/gitsss}}"
CUSTOM_PATH="$WORK_DIR"

GITSSS_WORK_DIR="${GITSSS_WORK_DIR:-${GITEA_WORK_DIR:-$WORK_DIR}}" \
GITSSS_CUSTOM="${GITSSS_CUSTOM:-${GITEA_CUSTOM:-$CUSTOM_PATH}}" \
GITEA_WORK_DIR="${GITEA_WORK_DIR:-${GITSSS_WORK_DIR:-$WORK_DIR}}" \
GITEA_CUSTOM="${GITEA_CUSTOM:-${GITSSS_CUSTOM:-$CUSTOM_PATH}}" \
exec -a "$0" "$GITSSS" $CONF_ARG "$@"
