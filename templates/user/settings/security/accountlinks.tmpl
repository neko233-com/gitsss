<h4 class="ui top attached header">
	{{ctx.Locale.Tr "settings.manage_account_links"}}
	{{if .OrderedOAuth2Names}}
		<div class="ui right">
			<div class="ui dropdown">
				<div class="ui primary tiny button">{{ctx.Locale.Tr "settings.link_account"}}</div>
				<div class="menu">
					{{range $key := .OrderedOAuth2Names}}
						{{$provider := index $.OAuth2Providers $key}}
						<a class="item" href="{{AppSubUrl}}/user/oauth2/{{$key | PathEscape}}">
							{{$provider.IconHTML 20}}
							{{$provider.DisplayName}}
						</a>
					{{end}}
				</div>
			</div>
		</div>
	{{end}}
</h4>

<div class="ui attached segment">
  <div class="identity-password-summary">
    {{svg "octicon-mail" 24}}
    <div><strong>{{ctx.Locale.Tr "settings.identity_email_password"}}</strong><p>{{.SignedUser.Email}}</p><small>{{if .HasLocalPassword}}{{ctx.Locale.Tr "settings.identity_password_ready"}}{{else}}{{ctx.Locale.Tr "settings.identity_password_unavailable"}}{{end}}</small></div>
    <a class="ui basic compact button" href="{{AppSubUrl}}/user/settings/account">{{ctx.Locale.Tr "settings.identity_manage_email"}}</a>
  </div>
  {{if not (or .AccountLinks .OrderedOAuth2Names)}}
  <p class="identity-unconfigured">{{ctx.Locale.Tr "settings.identity_channels_unconfigured"}}</p>
  {{if .SignedUser.IsAdmin}}<a class="ui basic compact button" href="{{AppSubUrl}}/-/admin/auths">{{ctx.Locale.Tr "settings.identity_configure_channels"}}</a>{{end}}
  {{end}}
	<div class="flex-divided-list items-with-main">
		<div class="item">
			{{ctx.Locale.Tr "settings.manage_account_links_desc"}}
		</div>
		{{range $loginSource, $provider := .AccountLinks}}
			<div class="item">
				{{$providerData := index $.OAuth2Providers $loginSource.Name}}
				<div class="item-leading">
					{{$providerData.IconHTML 20}}
				</div>
				<div class="item-main">
					<span class="item-title" data-tooltip-content="{{$provider}}">
						{{$loginSource.Name}}
					</span>
					{{$identity := index $.ExternalIdentityDetails $loginSource.ID}}
					{{if $identity}}<span class="flex-text-body">{{$identity.Name}}{{if $identity.Email}} · {{$identity.Email}}{{end}}</span>{{end}}
					{{if $loginSource.IsActive}}
					<span class="flex-text-body tw-text-primary">{{ctx.Locale.Tr "repo.settings.active"}}</span>
					{{end}}
				</div>
				<div class="item-trailing">
					{{if index $.NativeIdentitySources $loginSource.ID}}<a class="ui basic tiny button" href="{{AppSubUrl}}/user/oauth2/{{$loginSource.Name | PathEscape}}?bind=replace">{{ctx.Locale.Tr "settings.identity_replace"}}</a>{{end}}
					<button class="ui red tiny button link-action" data-modal-confirm="#delete-account-link" data-url="{{AppSubUrl}}/user/settings/security/account_link?id={{$loginSource.ID}}">
						{{ctx.Locale.Tr "settings.delete_key"}}
					</button>
				</div>
			</div>
		{{end}}
	</div>

	<div class="ui small modal" id="delete-account-link">
		<div class="header">
			{{svg "octicon-trash"}}
			{{ctx.Locale.Tr "settings.remove_account_link"}}
		</div>
		<div class="content">
			<p>{{ctx.Locale.Tr "settings.remove_account_link_desc"}}</p>
		</div>
		{{template "base/modal_actions_confirm" .}}
	</div>
</div>
