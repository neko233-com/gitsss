{{$usernameID := "user_name"}}{{$passwordID := "password"}}
{{if .LinkAccountMode}}{{$usernameID = "link_user_name"}}{{$passwordID = "link_password"}}{{end}}
<div class="auth-card">
	<h2 class="auth-card-title">
		{{if .LinkAccountMode}}
			{{ctx.Locale.Tr "auth.oauth_signin_title"}}
		{{else}}
			{{ctx.Locale.Tr "auth.login_userpass"}}
		{{end}}
	</h2>
	<p class="auth-card-intro">{{if .LinkAccountMode}}{{ctx.Locale.Tr "auth.oauth_bind_existing_help"}}{{else}}{{ctx.Locale.Tr "auth.ui.signin_help"}}{{end}}</p>
	{{if or (not .LinkAccountMode) (and .LinkAccountMode .LinkAccountModeSignIn)}}
	{{template "base/alert" .}}
	{{end}}
	<div class="auth-card-body">
		{{if .EnablePasswordSignInForm}}
		<form class="ui form ignore-dirty" action="{{.SignInLink}}" method="post" data-submit-feedback>
			<div class="required field {{if and (.Err_UserName) (or (not .LinkAccountMode) (and .LinkAccountMode .LinkAccountModeSignIn))}}error{{end}}">
				<label for="{{$usernameID}}">{{ctx.Locale.Tr "home.uname_holder"}}</label>
				<input id="{{$usernameID}}" type="text" name="user_name" autocomplete="username" autocapitalize="none" spellcheck="false" value="{{.user_name}}" autofocus required>
			</div>
			{{if or (not .DisablePassword) .LinkAccountMode}}
			<div class="required field {{if and (.Err_Password) (or (not .LinkAccountMode) (and .LinkAccountMode .LinkAccountModeSignIn))}}error{{end}}">
				<div class="tw-flex tw-mb-1">
					<label for="{{$passwordID}}" class="tw-flex-1">{{ctx.Locale.Tr "password"}}</label>
					<a href="{{AppSubUrl}}/user/forgot_password">{{ctx.Locale.Tr "auth.forgot_password"}}</a>
				</div>
				<div class="auth-password-input">
					<input id="{{$passwordID}}" name="password" type="password" autocomplete="current-password" required>
					<button type="button" class="auth-password-toggle" data-password-toggle aria-controls="{{$passwordID}}" aria-pressed="false" aria-label="{{ctx.Locale.Tr "auth.ui.show_password"}}" data-show="{{ctx.Locale.Tr "auth.ui.show_password"}}" data-hide="{{ctx.Locale.Tr "auth.ui.hide_password"}}">{{svg "octicon-eye" 18}}</button>
				</div>
			</div>
			{{end}}
			{{if not .LinkAccountMode}}
			<div class="inline field">
				<div class="ui checkbox">
					<label>{{ctx.Locale.Tr "auth.remember_me"}}</label>
					<input name="remember" type="checkbox">
				</div>
			</div>
			{{end}}

			{{template "user/auth/captcha" .}}

			<div class="field">
				<button type="submit" class="ui primary button tw-w-full auth-submit">
					{{if .LinkAccountMode}}
						{{ctx.Locale.Tr "auth.oauth_signin_submit"}}
					{{else}}
						{{ctx.Locale.Tr "sign_in"}}
					{{end}}
				</button>
			</div>
		</form>
		{{end}}{{/*end if .EnablePasswordSignInForm*/}}
		{{$showExternalAuthMethods := or .OAuth2Providers .EnableSSPI}}
		{{if and $showExternalAuthMethods .EnablePasswordSignInForm}}
			<div class="divider divider-text">{{ctx.Locale.Tr "sign_in_or"}}</div>
		{{end}}
		{{if $showExternalAuthMethods}}
			{{template "user/auth/external_auth_methods" .}}
		{{end}}
	</div>
</div>

{{if .ShowRegistrationButton}}
<div class="ui container fluid"><div class="ui attached segment header top tw-max-w-2xl tw-m-auto"><span>{{ctx.Locale.Tr "auth.need_account"}}</span> <a href="{{AppSubUrl}}/user/sign_up">{{ctx.Locale.Tr "auth.sign_up_now"}}</a></div></div>
{{end}}
