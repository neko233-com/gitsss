<section class="home-links" data-home-links data-error="{{ctx.Locale.Tr "home.links.error"}}" data-invalid="{{ctx.Locale.Tr "home.links.invalid"}}" data-conflict="{{ctx.Locale.Tr "home.links.conflict"}}">
	<div class="home-links-heading"><div><h2>{{ctx.Locale.Tr "home.links.services"}}</h2><p>{{ctx.Locale.Tr "home.links.help"}}</p></div></div>
	<div class="home-links-grid">
		{{range .SharedHomeLinks.Links}}{{template "user/dashboard/home_link_card" (dict "Link" . "Scope" (ctx.Locale.Tr "home.links.shared"))}}{{end}}
		{{range .PersonalHomeLinks.Links}}{{template "user/dashboard/home_link_card" (dict "Link" . "Scope" (ctx.Locale.Tr "home.links.personal"))}}{{end}}
	</div>
	<div class="home-links-editors">
		{{template "user/dashboard/home_links_editor" (dict "State" .PersonalHomeLinks "Scope" "personal" "Label" (ctx.Locale.Tr "home.links.personal"))}}
		{{if .SignedUser.IsAdmin}}{{template "user/dashboard/home_links_editor" (dict "State" .SharedHomeLinks "Scope" "shared" "Label" (ctx.Locale.Tr "home.links.shared"))}}{{end}}
	</div>
</section>
