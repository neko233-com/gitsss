{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content dashboard feeds">
	{{if .ContextUser.IsOrganization}}{{template "org/header" .}}{{else}}{{template "workspace/sidebar" .}}
 <header class="workspace-heading ui container"><div><h1>{{if .PageIsHomeLinks}}{{ctx.Locale.Tr "home.links.title"}}{{else if .OrganizationHome}}{{ctx.Locale.Tr "explore.organizations"}}{{else}}{{ctx.Locale.Tr "home.personal_dashboard"}}{{end}}</h1><p>{{ctx.Locale.Tr "workspace.home_help"}}</p></div>{{if .SignedUser.CanCreateOrganization}}<a class="ui primary button" href="{{AppSubUrl}}/org/create">{{svg "octicon-plus"}} {{ctx.Locale.Tr "new_org"}}</a>{{end}}</header>{{end}}

	{{if .PageIsHomeLinks}}
	<div class="ui container home-links-container">{{template "user/dashboard/home_links" .}}</div>
	{{else if .OrganizationHome}}
	<div class="ui container">
		{{template "base/alert" .}}

		{{if .Orgs}}<div class="ui icon input org-directory-search">{{svg "octicon-search" 16}}<input type="search" data-org-directory-search placeholder="{{ctx.Locale.Tr "search.org_kind"}}" aria-label="{{ctx.Locale.Tr "search.org_kind"}}"></div>{{end}}
		<div class="workspace-directory org-directory">
			{{range .Orgs}}
			<div class="workspace-directory-row" data-org-directory-item data-search="{{.Name}} {{.DisplayName}}">
				<a class="workspace-directory-identity flex-text-block" href="{{.OrganisationLink}}/dashboard">
					{{ctx.AvatarUtils.Avatar . 40}}
					<div><div class="header">{{template "org/identity" .}}</div><div class="meta">{{.NumRepos}} {{ctx.Locale.Tr "org.lower_repositories"}}</div></div>
				</a>
				<div class="workspace-directory-actions"><div class="flex-text-block">
					<a href="{{.HomeLink}}/-/kanban">{{ctx.Locale.Tr "org.global_kanban"}}</a>
					<a href="{{.HomeLink}}">{{ctx.Locale.Tr "user.repositories"}}</a>
				</div></div>
			</div>
			{{else}}
			<p>{{ctx.Locale.Tr "home.organizations_empty"}}</p>
			{{end}}
		</div>
		<p data-org-directory-empty hidden>{{ctx.Locale.Tr "no_results_found"}}</p>
		<hr>
		<div class="flex-text-block">
			{{if .SignedUser.CanCreateOrganization}}<a class="ui primary button" href="{{AppSubUrl}}/org/create">{{ctx.Locale.Tr "new_org"}}</a>{{end}}
			<a href="{{AppSubUrl}}/?view=personal">{{ctx.Locale.Tr "home.personal_dashboard"}}</a>
		</div>
	</div>
	{{else}}
	<div class="ui container dashboard-workspace">
		{{template "user/dashboard/repolist" .}}
		<section class="dashboard-stream" aria-label="{{ctx.Locale.Tr "activities"}}">
			{{template "base/alert" .}}
			<div class="dashboard-stream-header"><h2>{{ctx.Locale.Tr "activities"}}</h2></div>
			{{if .EnableHeatmap}}<details class="dashboard-contributions" open><summary>{{svg "octicon-calendar"}} {{ctx.Locale.Tr "dashboard.contributions.title"}}</summary>{{template "user/heatmap" .}}</details>{{end}}
			<div data-gitsss-plugin-slot="dashboard"></div>
			<div data-dashboard-feed-area data-error="{{ctx.Locale.Tr "org.workspace.load_error"}}">
			{{if .Page.Paginater.TotalPages}}
				{{template "user/dashboard/feeds" .}}
			{{else}}
				{{if .ContextUser.IsOrganization}}<p class="empty-placeholder">{{ctx.Locale.Tr "org.workspace.no_activity"}}</p>{{else}}{{template "user/dashboard/guide" .}}{{end}}
			{{end}}
			</div>
		</section>
		{{if or .ActionsDashboard .Announcements}}<aside class="dashboard-rail" aria-label="{{ctx.Locale.Tr "dashboard.actions.title"}}">
			{{template "user/dashboard/actions" .}}
			{{if .Announcements}}<section class="dashboard-announcements"><h2>{{ctx.Locale.Tr "dashboard.announcements"}}</h2>{{range .Announcements}}<article><h3>{{.Title}}</h3><p>{{.Body}}</p></article>{{end}}</section>{{end}}
		</aside>{{end}}
	</div>
	{{end}}
</div>
{{template "base/footer" .}}
