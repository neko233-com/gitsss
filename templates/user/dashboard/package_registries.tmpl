{{if .PackageRegistries}}
	<section class="package-registries" aria-labelledby="package-registries-title">
		<div class="home-links-heading">
			<div><h2 id="package-registries-title">{{ctx.Locale.Tr "packages.mirror.title"}}</h2><p>{{ctx.Locale.Tr "packages.mirror.help"}}</p></div>
			<span class="ui label">{{if .PackageMirrorEnabled}}{{ctx.Locale.Tr "packages.mirror.enabled"}}{{else}}{{ctx.Locale.Tr "packages.mirror.disabled"}}{{end}}</span>
		</div>
		<div class="package-registry-grid">
			{{range .PackageRegistries}}
				<article class="package-registry">
					<h3>{{svg "octicon-package" 20}} {{.Name}}</h3>
					<div class="package-registry-address"><code>{{.URL}}</code><button class="ui small icon button" type="button" data-clipboard-text="{{.URL}}" aria-label="{{.Name}} · {{ctx.Locale.Tr "copy_url"}}">{{svg "octicon-copy"}}</button></div>
					<details><summary>{{ctx.Locale.Tr "packages.mirror.setup"}}</summary>
						<pre><code>{{.Command}}</code></pre>
						<button class="ui small button" type="button" data-clipboard-text="{{.Command}}">{{svg "octicon-copy"}} {{ctx.Locale.Tr "copy"}}</button>
						<p class="package-registry-upstream">{{ctx.Locale.Tr "packages.mirror.upstream"}} <code>{{.Upstream}}</code></p>
					</details>
				</article>
			{{end}}
		</div>
		<p class="package-registry-note">{{ctx.Locale.Tr "packages.mirror.auth"}} <a href="{{AppSubUrl}}/help/site/workspace-centers.html#package-registries">{{ctx.Locale.Tr "packages.mirror.guide"}}</a></p>
	</section>
{{end}}
