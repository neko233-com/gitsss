{{if .EnableHeatmap}}
{{/*HINT: USER-ACTIVITY-PUSH-COMMITS: it only uses the doer's action time, it doesn't use git commit's time */}}
<div class="activity-heatmap-container">
	<div id="user-heatmap" class="is-loading"
		data-heatmap-url="{{.HeatmapURL}}"
		data-locale-total-contributions="{{ctx.Locale.Tr "heatmap.number_of_contributions_in_the_last_12_months" "%s"}}"
		data-locale-no-contributions="{{ctx.Locale.Tr "heatmap.no_contributions"}}"
		data-locale-more="{{ctx.Locale.Tr "heatmap.more"}}"
		data-locale-less="{{ctx.Locale.Tr "heatmap.less"}}"
		data-locale-error="{{ctx.Locale.Tr "heatmap.load_error"}}"
		data-locale-contributions="{{ctx.Locale.Tr "heatmap.contributions"}}"
		data-locale-summary="{{JsonUtils.EncodeToString (dict "title" (ctx.Locale.Tr "heatmap.summary.title") "total" (ctx.Locale.Tr "heatmap.summary.total") "recent7" (ctx.Locale.Tr "heatmap.summary.recent7") "recent30" (ctx.Locale.Tr "heatmap.summary.recent30") "active" (ctx.Locale.Tr "heatmap.summary.active") "peak" (ctx.Locale.Tr "heatmap.summary.peak") "method" (ctx.Locale.Tr "heatmap.summary.method") "ranges" (ctx.Locale.Tr "heatmap.summary.ranges") "settings" (ctx.Locale.Tr "heatmap.summary.settings") "minimum" (ctx.Locale.Tr "heatmap.summary.minimum") "color" (ctx.Locale.Tr "heatmap.summary.color") "apply" (ctx.Locale.Tr "heatmap.summary.apply") "reset" (ctx.Locale.Tr "heatmap.summary.reset") "invalid" (ctx.Locale.Tr "heatmap.summary.invalid") "local" (ctx.Locale.Tr "heatmap.summary.local"))}}"
	></div>
</div>
<div class="divider"></div>
{{end}}
