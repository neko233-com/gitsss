<dialog class="workspace-search-dialog" aria-labelledby="workspace-search-title"
 data-loading="{{ctx.Locale.Tr "workspace.search_loading"}}" data-empty="{{ctx.Locale.Tr "workspace.search_empty"}}" data-error="{{ctx.Locale.Tr "workspace.search_error"}}" data-results="{{ctx.Locale.Tr "workspace.search_results"}}"
 data-repos="{{ctx.Locale.Tr "workspace.search_repos"}}" data-issues="{{ctx.Locale.Tr "workspace.search_issues"}}" data-orgs="{{ctx.Locale.Tr "workspace.search_orgs"}}" data-pages="{{ctx.Locale.Tr "workspace.search_pages"}}">
 <div class="workspace-search-heading"><h2 id="workspace-search-title">{{ctx.Locale.Tr "workspace.search_title"}}</h2><button class="ui basic compact button" type="button" data-search-close aria-label="{{ctx.Locale.Tr "workspace.search_close"}}">Esc</button></div>
 <label for="workspace-search-input">{{ctx.Locale.Tr "workspace.search_hint"}}</label>
