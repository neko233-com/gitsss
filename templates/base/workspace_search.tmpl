<div id="datetime-labels" hidden data-today="{{ctx.Locale.Tr "datetime.today"}}" data-clear="{{ctx.Locale.Tr "datetime.clear"}}" data-invalid="{{ctx.Locale.Tr "datetime.invalid"}}" data-timezone="{{ctx.Locale.Tr "datetime.timezone"}}"></div>
