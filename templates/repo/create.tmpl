{{template "base/head" .}}
<div role="main"
     aria-label="{{.Title}}"
     class="page-content repository new-repo repo-create-page">
    <div class="repo-create-shell">
        <header class="repo-create-heading">
            <div>
                <h1>{{ctx.Locale.Tr "new_repo"}}</h1>
                <p>{{ctx.Locale.Tr "repo.create.intro"}}</p>
            </div>
            {{if not .DisableMigrations}}<a class="repo-create-import" data-repo-create-import href="{{AppSubUrl}}/repo/migrate?org={{.ContextUser.ID}}">{{svg "octicon-repo-push" 16}}{{ctx.Locale.Tr "repo.create.import_existing"}}</a>{{end}}
        </header>
        {{template "base/alert" .}}
        <form id="repo-create-form"
              class="ui form new-repo-form repo-create-workspace"
              action="{{.Link}}"
              method="post" data-submit-feedback>
            <div id="create-repo-error-message"
                 class="ui negative message tw-text-center tw-hidden"></div>
            <div class="repo-create-main">
                <section class="repo-create-section" aria-labelledby="repo-create-basics">
                    <h2 id="repo-create-basics">{{svg "octicon-repo" 20}}{{ctx.Locale.Tr "repo.create.basic_settings"}}</h2>
                    <div class="repo-create-name-fields">
                        <div class="required field {{if .Err_Owner}}error{{end}}">
                            <label id="repo-owner-label">{{ctx.Locale.Tr "repo.create.owner"}}</label>
                            <div class="ui search selection dropdown"
                                 id="repo_owner_dropdown"
                                 aria-labelledby="repo-owner-label">
                                <input type="hidden" name="uid" value="{{.ContextUser.ID}}">
                                <span class="text">{{template "repo/create_owner_identity" .ContextUser}}</span>
                                {{svg "octicon-triangle-down" 14 "dropdown icon"}}
                                <div class="menu">
                                    <div class="item"
                                         data-value="{{.SignedUser.ID}}"
                                         title="{{.SignedUser.Name}}"
                                         {{if not .CanCreateRepoInDoer}}
                                         data-create-repo-disallowed-prompt="{{ctx.Locale.TrN .MaxCreationLimit "repo.form.reach_limit_of_creation_1" "repo.form.reach_limit_of_creation_n" .MaxCreationLimitOfDoer}}"
                                         {{end}}>
                                        {{template "repo/create_owner_identity" .SignedUser}}
                                    </div>
                                    {{range .Orgs}}
                                    <div class="item" data-value="{{.ID}}" title="{{.Name}}">{{template "repo/create_owner_identity" .AsUser}}</div>
                                    {{end}}
                                </div>
                            </div>
                            <span class="help">{{ctx.Locale.Tr "repo.create.owner_help"}}</span>
                        </div>
                        <div class="required field {{if .Err_RepoName}}error{{end}}">
                            <label for="repo_name">{{ctx.Locale.Tr "repo.repo_name"}}</label>
                            <input id="repo_name" spellcheck="false" autocapitalize="none" aria-describedby="repo-name-help"
                                   name="repo_name"
                                   value="{{.repo_name}}"
                                   autofocus
                                   required
                                   maxlength="100">
                            <span class="help" id="repo-name-help" data-help-for-repo-name>{{ctx.Locale.Tr "repo.repo_name_helper"}}</span>
                            <span class="help tw-hidden" data-help-for-repo-name=".profile">{{ctx.Locale.Tr "repo.repo_name_profile_public_hint"}}</span>
                            <span class="help tw-hidden" data-help-for-repo-name=".profile-private">{{ctx.Locale.Tr "repo.repo_name_profile_private_hint"}}</span>
                        </div>
                    </div>
                    <div class="field {{if .Err_Description}}error{{end}}">
                        <label for="description">{{ctx.Locale.Tr "repo.repo_desc"}}</label>
                        <textarea id="description"
                                  rows="2"
                                  name="description"
                                  placeholder="{{ctx.Locale.Tr "repo.repo_desc_helper"}}"
                                  maxlength="2048">{{.description}}</textarea>
                    </div>
                    <div class="field">
                        <label>{{ctx.Locale.Tr "repo.visibility"}}</label>
                        <div class="ui checkbox">
                            {{if .IsForcedPrivate}}
                            <input name="private" type="checkbox" checked disabled>
                            <label>{{ctx.Locale.Tr "repo.visibility_helper_forced"}}</label>
                        {{else}}
                            <input name="private" type="checkbox" {{if .private}}checked{{end}}>
                            <label>{{ctx.Locale.Tr "repo.visibility_helper"}}</label>
                            {{end}}
                        </div>
                        <span class="help"
                              data-repo-visibility-help
                              data-private="{{ctx.Locale.Tr "repo.create.visibility_private"}}"
                              data-public="{{ctx.Locale.Tr "repo.create.visibility_public"}}">{{if or .private .IsForcedPrivate}}{{ctx.Locale.Tr "repo.create.visibility_private"}}{{else}}{{ctx.Locale.Tr "repo.create.visibility_public"}}{{end}}</span>
                    </div>
                </section>
                <section id="non_template"
                         class="repo-create-section"
                         aria-labelledby="repo-create-content-title">
                    <h2 id="repo-create-content-title">
                        {{svg "octicon-file-directory" 20}}{{ctx.Locale.Tr "repo.create.initial_settings"}}
                    </h2>
                    <p class="repo-create-section-help">{{ctx.Locale.Tr "repo.create.mode_help"}}</p>
                    <input id="repo-auto-init"
                           name="auto_init"
                           type="checkbox"
                           class="tw-hidden"
                           {{if .auto_init}}
                           checked
                           {{end}}>
                    <div class="repo-create-modes">
                        <label class="repo-create-mode">
                            <input type="radio"
                                   name="gitsss_initial_mode"
                                   value="empty"
                                   {{if not .auto_init}}
                                   checked
                                   {{end}}>
                            <span><strong>{{ctx.Locale.Tr "repo.create.mode_empty"}}</strong><small>{{ctx.Locale.Tr "repo.create.mode_empty_help"}}</small></span>
                        </label>
                        <label class="repo-create-mode">
                            <input type="radio"
                                   name="gitsss_initial_mode"
                                   value="initialize"
                                   {{if .auto_init}}
                                   checked
                                   {{end}}>
                            <span><strong>{{ctx.Locale.Tr "repo.create.mode_initialize"}}</strong><small>{{ctx.Locale.Tr "repo.create.mode_initialize_help"}}</small></span>
                        </label>
                    </div>
                    <div data-repo-initial-files class="repo-create-initial-files">
                        <div class="field">
                            <label>{{ctx.Locale.Tr "repo.readme"}}</label>
                            <div class="ui selection dropdown">
                                <input type="hidden" name="readme" value="{{.readme}}">
                                <div class="default text">{{ctx.Locale.Tr "repo.readme_helper"}}</div>
                                <div class="menu">
                                    {{range .Readmes}}
                                    <div class="item" data-value="{{.}}">{{.}}</div>
                                    {{end}}
                                </div>
                            </div>
                            <span class="help">{{ctx.Locale.Tr "repo.readme_helper_desc"}}</span>
                        </div>
                        <div class="field">
                            <label>.gitignore</label>
                            <div class="ui multiple search selection dropdown">
                                <input type="hidden" name="gitignores" value="{{.gitignores}}">
                                <div class="default text">{{ctx.Locale.Tr "repo.repo_gitignore_helper"}}</div>
                                <div class="menu">
                                    {{range .Gitignores}}
                                    <div class="item" data-value="{{.}}">{{.}}</div>
                                    {{end}}
                                </div>
                            </div>
                            <span class="help">{{ctx.Locale.Tr "repo.repo_gitignore_helper_desc"}}</span>
                        </div>
                        <div class="field">
                            <label>{{ctx.Locale.Tr "repo.license"}}</label>
                            <div class="ui search selection dropdown">
                                <input type="hidden" name="license" value="{{.license}}">
                                <div class="default text">{{ctx.Locale.Tr "repo.license_helper"}}</div>
                                <div class="menu">
                                    <div class="item" data-value="">{{ctx.Locale.Tr "repo.license_helper"}}</div>
                                    {{range .Licenses}}
                                    <div class="item" data-value="{{.}}">{{.}}</div>
                                    {{end}}
                                </div>
                            </div>
                            <span class="help">{{ctx.Locale.Tr "repo.license_helper_desc" "https://choosealicense.com/"}}</span>
                        </div>
                    </div>
                    <div class="field">
                        <label for="default_branch">{{ctx.Locale.Tr "repo.default_branch"}}</label>
                        <input id="default_branch"
                               name="default_branch"
                               value="{{.default_branch}}"
                               placeholder="{{.default_branch}}">
                        <span class="help">{{ctx.Locale.Tr "repo.default_branch_helper"}}</span>
                    </div>
                    <details class="repo-create-disclosure">
                        <summary>{{ctx.Locale.Tr "repo.create.advanced"}}</summary>
                        <div class="repo-create-disclosure-body">
                            <div class="field">
                                <label>{{ctx.Locale.Tr "repo.issue_labels"}}</label>
                                <div class="ui search selection dropdown">
                                    <input type="hidden" name="issue_labels" value="{{.issueLabels}}">
                                    <div class="default text">{{ctx.Locale.Tr "repo.issue_labels_helper"}}</div>
                                    <div class="menu">
                                        <div class="item" data-value="">{{ctx.Locale.Tr "repo.issue_labels_helper"}}</div>
                                        {{range .LabelTemplateFiles}}
                                        <div class="item" data-value="{{.DisplayName}}">
                                            {{.DisplayName}}
                                            <br>
                                            <i>({{.Description}})</i>
                                        </div>
                                        {{end}}
                                    </div>
                                </div>
                            </div>
                            <div class="field">
                                <label>{{ctx.Locale.Tr "repo.object_format"}}</label>
                                <div class="ui selection owner dropdown">
                                    <input type="hidden"
                                           id="object_format_name"
                                           name="object_format_name"
                                           value="{{or .object_format_name .DefaultObjectFormat.Name}}"
                                           required>
                                    <div class="default text">{{.DefaultObjectFormat.Name}}</div>
                                    <div class="menu">
                                        {{range .SupportedObjectFormats}}
                                        <div class="item" data-value="{{.Name}}">{{.Name}}</div>
                                        {{end}}
                                    </div>
                                </div>
                                <span class="help">{{ctx.Locale.Tr "repo.object_format_helper"}}</span>
                            </div>
                            <div class="field">
                                <label>{{ctx.Locale.Tr "repo.create.as_template"}}</label>
                                <div class="ui checkbox">
                                    <input name="template" type="checkbox">
                                    <label>{{ctx.Locale.Tr "repo.template_helper"}}</label>
                                </div>
                            </div>
                        </div>
                    </details>
                </section>
                <details class="repo-create-section repo-create-disclosure"
                         {{if .repo_template}}
                         open
                         {{end}}>
                    <summary>
                        {{svg "octicon-repo-template" 20}}{{ctx.Locale.Tr "repo.create.source_template"}}<span>{{ctx.Locale.Tr "repo.create.optional"}}</span>
                    </summary>
                    <div class="repo-create-disclosure-body">
                        <div class="field">
                            <label>{{ctx.Locale.Tr "repo.create.source_template"}}</label>
                            <div id="repo_template_search" class="ui search selection dropdown">
                                <input type="hidden"
                                       id="repo_template"
                                       name="repo_template"
                                       value="{{or .repo_template ""}}">
                                <div class="default text">{{.repo_template_name}}</div>
                                <div class="menu"></div>
                            </div>
                            <span class="help">{{ctx.Locale.Tr "repo.create.source_template_help"}}</span>
                        </div>
                        <div id="template_units" class="tw-hidden">
                            <div class="field">
                                <label>{{ctx.Locale.Tr "repo.template.items"}}</label>
                                <div class="ui checkbox">
                                    <input name="git_content" type="checkbox" {{if .git_content}}checked{{end}}>
                                    <label>{{ctx.Locale.Tr "repo.template.git_content"}}</label>
                                </div>
                                <div class="ui checkbox"
                                     {{if not .SignedUser.CanEditGitHook}}
                                     data-tooltip-content="{{ctx.Locale.Tr "repo.template.git_hooks_tooltip"}}"
                                     {{end}}>
                                    <input name="git_hooks" type="checkbox" {{if .git_hooks}}checked{{end}}>
                                    <label>{{ctx.Locale.Tr "repo.template.git_hooks"}}</label>
                                </div>
                            </div>
                            <div class="field">
                                <div class="ui checkbox">
                                    <input name="webhooks" type="checkbox" {{if .webhooks}}checked{{end}}>
                                    <label>{{ctx.Locale.Tr "repo.template.webhooks"}}</label>
                                </div>
                                <div class="ui checkbox">
                                    <input name="topics" type="checkbox" {{if .topics}}checked{{end}}>
                                    <label>{{ctx.Locale.Tr "repo.template.topics"}}</label>
                                </div>
                            </div>
                            <div class="field">
                                <div class="ui checkbox">
                                    <input name="avatar" type="checkbox" {{if .avatar}}checked{{end}}>
                                    <label>{{ctx.Locale.Tr "repo.template.avatar"}}</label>
                                </div>
                                <div class="ui checkbox">
                                    <input name="labels" type="checkbox" {{if .labels}}checked{{end}}>
                                    <label>{{ctx.Locale.Tr "repo.template.issue_labels"}}</label>
                                </div>
                            </div>
                            <div class="field">
                                <div class="ui checkbox">
                                    <input name="protected_branch"
                                           type="checkbox"
                                           {{if .protected_branch}}
                                           checked
                                           {{end}}>
                                    <label>{{ctx.Locale.Tr "repo.settings.protected_branch"}}</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </details>
            </div>
            <aside class="repo-create-preview"
                   aria-labelledby="repo-create-preview-title">
                <h2 id="repo-create-preview-title">{{ctx.Locale.Tr "repo.create.preview"}}</h2>
                <div class="repo-create-preview-path">
                    {{svg "octicon-repo" 24}}<span data-repo-create-path>{{.ContextUser.Name}} / {{or .repo_name (ctx.Locale.Tr "repo.create.name_placeholder")}}</span>
                </div>
                <p data-repo-create-description class="repo-create-preview-description"></p>
                <dl>
                    <div>
                        <dt>{{ctx.Locale.Tr "repo.create.owner"}}</dt>
                        <dd data-repo-create-owner>
                        </dd>
                    </div>
                    <div>
                        <dt>{{ctx.Locale.Tr "repo.visibility"}}</dt>
                        <dd data-repo-create-visibility>
                        </dd>
                    </div>
                    <div>
                        <dt>{{ctx.Locale.Tr "repo.default_branch"}}</dt>
                        <dd data-repo-create-branch>
                        </dd>
                    </div>
                </dl>
                <div class="repo-create-preview-result"
                     data-empty="{{ctx.Locale.Tr "repo.create.result_empty"}}"
                     data-initialize="{{ctx.Locale.Tr "repo.create.result_initialize"}}"
                     data-template="{{ctx.Locale.Tr "repo.create.result_template"}}"></div>
                <button type="submit" class="ui primary button repo-create-submit">
                    {{svg "octicon-plus" 16}}{{ctx.Locale.Tr "repo.create_repo"}}
                </button>
                <p class="repo-create-preview-note">{{ctx.Locale.Tr "repo.create.preview_note"}}</p>
                <span class="tw-hidden"
                      data-repo-create-i18n
                      data-template-branch="{{ctx.Locale.Tr "repo.create.template_branch"}}"
                      data-placeholder="{{ctx.Locale.Tr "repo.create.name_placeholder"}}"
                      data-private="{{ctx.Locale.Tr "repo.create.private_label"}}"
                      data-public="{{ctx.Locale.Tr "repo.create.public_label"}}"
                      data-no-description="{{ctx.Locale.Tr "repo.create.no_description"}}"></span>
            </aside>
        </form>
    </div>
</div>
{{template "base/footer" .}}
