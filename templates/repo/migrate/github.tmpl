{{template "repo/migrate/workspace_start" .}}


				<input id="service_type" type="hidden" name="service" value="{{.service}}">

				<div class="required field {{if .Err_CloneAddr}}error{{end}}">
					<label for="clone_addr">{{ctx.Locale.Tr "repo.migrate.clone_address"}}</label>
					<input id="clone_addr" name="clone_addr" spellcheck="false" autocapitalize="none" value="{{.clone_addr}}" autofocus required>
					<span class="help">
					{{ctx.Locale.Tr "repo.migrate.clone_address_desc"}}
					</span>
				</div>

				<div class="field {{if .Err_Auth}}error{{end}}">
					<label for="auth_token">{{ctx.Locale.Tr "access_token"}}</label>
					<input id="auth_token" name="auth_token" type="password" autocomplete="new-password" value="{{.auth_token}}" {{if not .auth_token}}data-need-clear="true"{{end}}>
					<a target="_blank" rel="noopener noreferrer" aria-label="{{ctx.Locale.Tr "repo.migrate.token_help"}}" href="https://docs.github.com/en/github/authenticating-to-github/creating-a-personal-access-token">{{svg "octicon-question"}}</a>
					<span class="help">
					{{ctx.Locale.Tr "repo.migrate.github_token_desc"}}
					</span>
				</div>

				</section>
<details class="repo-migrate-section repo-migrate-options" {{if or .mirror .lfs .Err_LFSEndpoint}}open{{end}}>
<summary><span>{{svg "octicon-sliders" 18}}{{ctx.Locale.Tr "repo.migrate.transfer_settings"}}</span><small>{{ctx.Locale.Tr "repo.migrate.options_summary"}}</small></summary>
<div class="repo-migrate-options-body">
{{template "repo/migrate/options" .}}

				<div class="field">
					<label>{{ctx.Locale.Tr "repo.migrate_items"}}</label>
					<div class="ui checkbox">
						<input name="wiki" type="checkbox" {{if .wiki}}checked{{end}}>
						<label>{{ctx.Locale.Tr "repo.migrate_items_wiki"}}</label>
					</div>
				</div>
				<div id="migrate_items" class="field">
					<span class="help">{{ctx.Locale.Tr "repo.migrate.migrate_items_options"}}</span>
					<div class="field">
						<label></label>
						<div class="ui checkbox">
							<input name="labels" type="checkbox" {{if .labels}}checked{{end}}>
							<label>{{ctx.Locale.Tr "repo.migrate_items_labels"}}</label>
						</div>
						<div class="ui checkbox">
							<input name="issues" type="checkbox" {{if .issues}}checked{{end}}>
							<label>{{ctx.Locale.Tr "repo.migrate_items_issues"}}</label>
						</div>
					</div>
					<div class="field">
						<label></label>
						<div class="ui checkbox">
							<input name="pull_requests" type="checkbox" {{if .pull_requests}}checked{{end}}>
							<label>{{ctx.Locale.Tr "repo.migrate_items_pullrequests"}}</label>
						</div>
						<div class="ui checkbox">
							<input name="releases" type="checkbox" {{if .releases}}checked{{end}}>
							<label>{{ctx.Locale.Tr "repo.migrate_items_releases"}}</label>
						</div>
					</div>
					<div class="field">
						<label></label>
						<div class="ui checkbox">
							<input name="milestones" type="checkbox" {{if .milestones}}checked{{end}}>
							<label>{{ctx.Locale.Tr "repo.migrate_items_milestones"}}</label>
						</div>
					</div>
				</div>


{{template "repo/migrate/destination" .}}
