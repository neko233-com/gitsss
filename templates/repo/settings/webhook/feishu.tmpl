{{if eq .HookType "feishu"}}
	<p>
		{{ctx.Locale.Tr "repo.settings.add_web_hook_desc" "https://feishu.cn" (ctx.Locale.Tr "repo.settings.web_hook_name_feishu")}}
		{{ctx.Locale.Tr "repo.settings.add_web_hook_desc" "https://larksuite.com" (ctx.Locale.Tr "repo.settings.web_hook_name_larksuite")}}
	</p>
	<form class="ui form" action="{{.BaseLink}}/feishu/{{or .Webhook.ID "new"}}" method="post">
		<div class="required field {{if .Err_PayloadURL}}error{{end}}">
			<label for="payload_url">{{ctx.Locale.Tr "repo.settings.payload_url"}}</label>
			<input id="payload_url" name="payload_url" type="url" value="{{.Webhook.URL}}" autofocus required>
		</div>
		<div class="field {{if .Err_MessageTemplate}}error{{end}}">
			<label for="message_template">{{ctx.Locale.Tr "repo.settings.webhook.message_template"}}</label>
			<textarea id="message_template" name="message_template" rows="8" maxlength="16384" placeholder="[&#123;&#123;.Event&#125;&#125;] &#123;&#123;.Text&#125;&#125;">{{.FeishuHook.MessageTemplate}}</textarea>
			<p class="help">{{ctx.Locale.Tr "repo.settings.webhook.message_template_helper" (HTMLFormat "<code>%s</code> <code>%s</code> <code>%s</code>" "\u007b\u007b.Event\u007d\u007d" "\u007b\u007b.Text\u007d\u007d" "\u007b\u007b.Payload.repository.full_name\u007d\u007d")}}</p>
		</div>
		{{template "repo/settings/webhook/settings" dict "BaseLink" .BaseLink "Webhook" .Webhook "UseRequestSecret" "optional"}}
	</form>
{{end}}
