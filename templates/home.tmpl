{{template "base/head" .}}
<main class="page-content home gitsss-landing" aria-label="{{ctx.Locale.Tr "home_title"}}">
 <div class="landing-content">
  <section class="landing-hero">
   <div class="landing-copy">
    <h1>{{ctx.Locale.Tr "home.workspace_title"}}<br>{{ctx.Locale.Tr "home.workspace_title_end"}}</h1>
    <p class="landing-description">{{ctx.Locale.Tr "home.workspace_description"}}</p>
    <div class="landing-actions"><a class="landing-primary" href="{{AppSubUrl}}/user/login">{{ctx.Locale.Tr "home.workspace_login"}} {{svg "octicon-arrow-right" 22}}</a><a href="{{AppSubUrl}}/help/">{{ctx.Locale.Tr "home.workspace_docs"}}</a></div>
    <p class="landing-account">{{ctx.Locale.Tr "home.workspace_account"}}</p>
   </div>
   <div class="landing-visual">
    <div class="landing-shader" data-landing-shader aria-hidden="true"></div>
    <svg class="landing-shader-fallback" viewBox="0 0 760 560" fill="none" aria-hidden="true"><g stroke="currentColor" stroke-width="1.5"><path d="M0 280C180 280 220 100 440 100H760M0 280C240 280 230 220 440 220H760M0 280C210 280 280 330 440 330H760M0 280C240 280 240 460 620 460H760"/><circle class="landing-flow-node" cx="680" cy="100" r="8"/><circle class="landing-flow-node" cx="680" cy="220" r="8"/><circle class="landing-flow-node" cx="680" cy="330" r="8"/><circle class="landing-flow-node" cx="680" cy="460" r="8"/></g></svg>
    <svg class="landing-particles" viewBox="0 0 760 560" aria-hidden="true"><g class="landing-pointer-particles"><circle cx="-24" cy="-8" r="2"/><circle cx="18" cy="-22" r="3"/><circle cx="30" cy="12" r="2"/><circle cx="-10" cy="28" r="2"/><circle cx="3" cy="-38" r="2"/><circle cx="-38" cy="16" r="3"/><circle cx="42" cy="-16" r="2"/><circle cx="15" cy="40" r="2"/></g></svg>
    <button type="button" class="landing-motion" data-landing-motion data-play="{{ctx.Locale.Tr "home.workspace_play"}}" data-pause="{{ctx.Locale.Tr "home.workspace_pause"}}" hidden>{{ctx.Locale.Tr "home.workspace_pause"}}</button>
   </div>
  </section>
  <section class="landing-capabilities" aria-label="{{ctx.Locale.Tr "home.workspace_resources"}}">
   <div>{{svg "octicon-git-branch" 36}}<h2>{{ctx.Locale.Tr "home.workspace_code"}}</h2><p>{{ctx.Locale.Tr "home.workspace_code_desc"}}</p></div>
   <div>{{svg "octicon-gear" 36}}<h2>{{ctx.Locale.Tr "home.workspace_delivery"}}</h2><p>{{ctx.Locale.Tr "home.workspace_delivery_desc"}}</p></div>
   <div>{{svg "octicon-people" 36}}<h2>{{ctx.Locale.Tr "home.workspace_resources"}}</h2><p>{{ctx.Locale.Tr "home.workspace_resources_desc"}}</p></div>
  </section>
 </div>
</main>
{{template "base/footer" .}}
