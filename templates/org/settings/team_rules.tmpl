{{template "org/settings/layout_head" (dict "pageClass" "organization settings team-rules")}}
<div class="org-setting-content">
	<h2>{{ctx.Locale.Tr "org.team_rules.title"}}</h2>
	<p>{{ctx.Locale.Tr "org.team_rules.help"}}</p>
	<div class="ui segment">
		<form class="ui form" method="post" action="{{.OrgLink}}/settings/team-rules">
			{{.CsrfTokenHtml}}
			<input type="hidden" name="revision" value="{{.RuleState.Revision}}">
			<input type="hidden" name="id" value="{{.DraftRule.ID}}">
			<div class="field"><label for="repo-rule-pattern">{{ctx.Locale.Tr "org.team_rules.pattern"}}</label><input id="repo-rule-pattern" name="pattern" value="{{.DraftRule.Pattern}}" placeholder="^(client|server)-" maxlength="512" required><p class="help">{{ctx.Locale.Tr "org.team_rules.pattern_help"}}</p></div>
			<div class="field"><label for="repo-rule-teams">{{ctx.Locale.Tr "org.teams"}}</label><select class="ui search fluid dropdown" id="repo-rule-teams" name="team_id" multiple required>{{range .RuleTeams}}<option value="{{.ID}}" {{if index $.SelectedRuleTeams .ID}}selected{{end}}>{{.DisplayLabel}}</option>{{end}}</select></div>
			<div class="field"><label><input type="checkbox" name="enabled" value="true" {{if .DraftRule.Enabled}}checked{{end}}> {{ctx.Locale.Tr "org.team_rules.enabled"}}</label></div>
			<div class="flex-text-block"><button class="ui button" name="action" value="preview">{{ctx.Locale.Tr "org.team_rules.preview"}}</button><button class="ui primary button" name="action" value="save">{{ctx.Locale.Tr "save"}}</button>{{if .DraftRule.ID}}<a href="{{.OrgLink}}/settings/team-rules">{{ctx.Locale.Tr "cancel"}}</a>{{end}}</div>
		</form>
		{{if .ShowPreview}}<div class="ui divider"></div><h3>{{ctx.Locale.Tr "org.team_rules.matches" (len .PreviewRepos)}}</h3><div class="flex-text-block tw-flex-wrap">{{range .PreviewRepos}}<a href="{{.Link}}">{{.Name}}</a>{{end}}</div>{{end}}
	</div>
	<table class="ui table"><thead><tr><th>{{ctx.Locale.Tr "org.team_rules.pattern"}}</th><th>{{ctx.Locale.Tr "org.teams"}}</th><th>{{ctx.Locale.Tr "org.team_rules.enabled"}}</th><th>{{ctx.Locale.Tr "repo.commit.operations"}}</th></tr></thead><tbody>
	{{range .RuleState.Rules}}<tr><td><code>{{.Pattern}}</code></td><td>{{range .TeamIDs}}<span class="ui small label">{{index $.TeamLabels .}}</span>{{end}}</td><td>{{if .Enabled}}{{svg "octicon-check"}}{{else}}—{{end}}</td><td><div class="flex-text-block tw-flex-wrap"><a class="ui small button" href="{{$.OrgLink}}/settings/team-rules?edit={{.ID}}">{{ctx.Locale.Tr "edit"}}</a><form method="post" action="{{$.OrgLink}}/settings/team-rules">{{$.CsrfTokenHtml}}<input type="hidden" name="revision" value="{{$.RuleState.Revision}}"><input type="hidden" name="id" value="{{.ID}}">{{if .Enabled}}<button class="ui small button" name="action" value="apply">{{ctx.Locale.Tr "org.team_rules.apply"}}</button>{{end}}<button class="ui small basic negative button" name="action" value="delete">{{ctx.Locale.Tr "remove"}}</button></form></div></td></tr>{{else}}<tr><td colspan="4">{{ctx.Locale.Tr "org.team_rules.empty"}}</td></tr>{{end}}
	</tbody></table>
</div>
{{template "org/settings/layout_footer" .}}
