{{template "base/head" .}}
<main class="page-content organization" aria-label="{{.Title}}">
 {{template "org/header" .}}
 <section class="ui container software-center" data-software-center data-user-id="{{.SignedUser.ID}}" data-base="{{.Org.HomeLink}}/-/software" data-labels="{{JsonUtils.EncodeToString .SoftwareStrings}}"
  data-error="{{ctx.Locale.Tr "software.load_error"}}" data-empty="{{ctx.Locale.Tr "software.empty"}}" data-delete="{{ctx.Locale.Tr "software.delete_confirm"}}" data-cancel="{{ctx.Locale.Tr "cancel"}}"
  data-rename="{{ctx.Locale.Tr "software.rename"}}" data-remove="{{ctx.Locale.Tr "software.delete"}}" data-folder="{{ctx.Locale.Tr "software.folder"}}" data-file="{{ctx.Locale.Tr "software.file"}}" data-new-folder="{{ctx.Locale.Tr "software.new_folder"}}">
  <div class="software-toolbar">
   <label class="workspace-filter">{{svg "octicon-search"}}<input type="search" data-software-search placeholder="{{ctx.Locale.Tr "software.search"}}" aria-label="{{ctx.Locale.Tr "software.search"}}"></label>
   <label class="software-platform-filter"><span>{{ctx.Locale.Tr "software.platform_filter"}}</span><select data-software-platform aria-label="{{ctx.Locale.Tr "software.platform_filter"}}"><option value="">{{ctx.Locale.Tr "software.platform_filter_all"}}</option><option value="Windows">Windows</option><option value="macOS">macOS</option><option value="iOS">iOS</option><option value="Android">Android</option><option value="all">{{ctx.Locale.Tr "software.platform_all"}}</option><option value="unknown">{{ctx.Locale.Tr "software.platform_unknown"}}</option></select></label>
   <span data-software-usage></span>
   <button class="ui basic button" data-software-mkdir>{{svg "octicon-file-directory"}} {{ctx.Locale.Tr "software.new_folder"}}</button>
   <label class="ui primary button software-upload-label">{{svg "octicon-upload"}} {{ctx.Locale.Tr "software.upload"}}<input type="file" name="files" aria-label="{{ctx.Locale.Tr "software.upload"}}" data-software-upload multiple></label>
   <label class="ui basic button software-upload-label">{{svg "octicon-file-directory"}} {{ctx.Locale.Tr "software.upload_folder"}}<input type="file" name="folder" aria-label="{{ctx.Locale.Tr "software.upload_folder"}}" data-software-folder-upload webkitdirectory multiple></label>
   <button class="ui basic button" type="button" data-software-organize>{{svg "octicon-list-unordered"}} {{ctx.Locale.Tr "software.organize"}}</button>
  </div>
  <p class="software-drop-hint" data-software-drop>{{svg "octicon-upload"}} {{ctx.Locale.Tr "software.drop"}} <span>{{ctx.Locale.Tr "software.folder_hint"}}</span></p>
  <p data-software-status role="status" aria-live="polite"></p>
  <div class="software-selection-toolbar" data-software-selection hidden><strong data-software-selected></strong><button class="ui basic compact button" data-software-batch-download>{{ctx.Locale.Tr "software.download_selected"}}</button><button class="ui basic compact button" data-software-batch-move>{{ctx.Locale.Tr "software.move"}}</button><button class="ui basic compact red button" data-software-batch-delete>{{ctx.Locale.Tr "software.delete_selected"}}</button><button class="ui basic compact button" data-software-clear>{{ctx.Locale.Tr "software.clear"}}</button></div>
  {{if .IsOrganizationOwner}}<details class="software-quota-settings"><summary>{{ctx.Locale.Tr "software.quota"}}</summary><form class="ui form software-toolbar" data-software-quota><label>{{ctx.Locale.Tr "software.quota"}} (GiB)<input name="gib" type="number" min="1" max="10240" value="100" required></label><button class="ui basic button">{{ctx.Locale.Tr "save"}}</button></form></details>{{end}}
  <div class="software-layout">
   <nav class="software-tree" aria-label="{{ctx.Locale.Tr "software.folders"}}"><button data-software-root>{{svg "octicon-home"}} {{ctx.Locale.Tr "software.root"}}</button><div data-software-tree></div></nav>
   <section class="software-files">
    <nav class="software-breadcrumbs" data-software-breadcrumbs aria-label="{{ctx.Locale.Tr "software.path"}}"></nav>
    <div class="software-table-scroll"><table class="ui very basic unstackable compact table">
     <thead><tr><th class="software-select-cell"><input type="checkbox" data-software-select-all aria-label="{{ctx.Locale.Tr "software.select_all"}}"></th><th>{{ctx.Locale.Tr "name"}} <span class="tw-text-text-light">A–Z</span></th><th>{{ctx.Locale.Tr "software.platform"}}</th><th>{{ctx.Locale.Tr "software.size"}}</th><th>{{ctx.Locale.Tr "software.modified"}}</th><th>{{ctx.Locale.Tr "software.actions"}}</th></tr></thead>
     <tbody data-software-rows></tbody>
    </table></div>
    <div data-software-empty hidden><p>{{ctx.Locale.Tr "software.empty"}}</p><button class="ui basic button" data-software-empty-upload>{{ctx.Locale.Tr "software.empty_action"}}</button></div>
    <nav class="software-pages"><button class="ui basic button" data-software-prev>{{ctx.Locale.Tr "repo.issues.previous"}}</button><span data-software-page></span><button class="ui basic button" data-software-next>{{ctx.Locale.Tr "repo.issues.next"}}</button></nav>
   </section>
  </div>
  <div class="software-size-legend" aria-label="{{ctx.Locale.Tr "software.size_legend"}}"><span>{{ctx.Locale.Tr "software.size_legend"}}</span><span class="software-size" data-band="tiny">&lt; 10 MiB</span><span class="software-size" data-band="small">10–100 MiB</span><span class="software-size" data-band="medium">100 MiB–1 GiB</span><span class="software-size" data-band="large">1–10 GiB</span><span class="software-size" data-band="huge">≥ 10 GiB</span></div>
  <details class="software-transfers" data-transfer-panel open hidden><summary data-transfer-summary>{{ctx.Locale.Tr "software.transfers"}}</summary><div class="software-transfer-toolbar"><button class="ui basic compact button" data-transfer-pause>{{svg "octicon-pause"}} {{ctx.Locale.Tr "software.pause_all"}}</button><button class="ui basic compact button" data-transfer-resume>{{svg "octicon-play"}} {{ctx.Locale.Tr "software.resume_all"}}</button></div><p>{{ctx.Locale.Tr "software.browser_downloads"}}</p><section class="software-uploads" data-transfer-uploads aria-label="{{ctx.Locale.Tr "software.uploads"}}"></section><section class="software-uploads" data-transfer-downloads aria-label="{{ctx.Locale.Tr "software.download"}}"></section></details>
  <dialog class="software-name-dialog" data-software-dialog aria-labelledby="software-name-title">
   <form class="ui form"><h2 id="software-name-title" data-software-dialog-title></h2><label>{{ctx.Locale.Tr "name"}}<input name="name" required maxlength="255" autocomplete="off" aria-describedby="software-name-error"></label><p id="software-name-error" data-software-dialog-error role="alert"></p><div class="software-dialog-buttons"><button class="ui basic button" type="button" data-software-dialog-cancel>{{ctx.Locale.Tr "cancel"}}</button><button class="ui primary button" type="submit">{{ctx.Locale.Tr "save"}}</button></div></form>
  </dialog>
  <dialog class="software-move-dialog" data-software-move-dialog aria-labelledby="software-move-title">
   <h2 id="software-move-title">{{ctx.Locale.Tr "software.move"}}</h2><label class="workspace-filter">{{svg "octicon-search"}}<input type="search" name="destination" autocomplete="off" data-software-move-search aria-label="{{ctx.Locale.Tr "software.destination"}}" placeholder="{{ctx.Locale.Tr "software.destination"}}…"></label><nav class="software-breadcrumbs" data-software-move-path aria-label="{{ctx.Locale.Tr "software.destination"}}"></nav><div class="software-move-folders" data-software-move-folders></div><p role="alert" data-software-move-error></p><div class="software-dialog-buttons"><button class="ui basic button" type="button" data-software-move-cancel>{{ctx.Locale.Tr "cancel"}}</button><button class="ui primary button" type="button" data-software-move-confirm>{{ctx.Locale.Tr "software.move_here"}}</button></div>
  </dialog>
  <dialog class="software-organize-dialog" data-software-organize-dialog aria-labelledby="software-organize-title">
   <h2 id="software-organize-title">{{ctx.Locale.Tr "software.organize_title"}}</h2>
   <p>{{ctx.Locale.Tr "software.organize_help"}}</p>
   <p data-software-organize-status role="status" aria-live="polite"></p>
   <section data-software-organize-results hidden>
    <ul class="software-organize-summary"><li><span>{{ctx.Locale.Tr "software.organize_changes"}}</span><strong data-software-organize-change-count></strong></li><li><span>{{ctx.Locale.Tr "software.organize_created"}}</span><strong data-software-organize-created-count></strong></li><li><span>{{ctx.Locale.Tr "software.organize_skipped"}}</span><strong data-software-organize-skipped-count></strong></li></ul>
    <p data-software-organize-empty hidden>{{ctx.Locale.Tr "software.organize_empty"}}</p>
    <div class="software-organize-changes" data-software-organize-changes>
     <table class="ui very basic compact table"><thead><tr><th>{{ctx.Locale.Tr "software.organize_from"}}</th><th>{{ctx.Locale.Tr "software.organize_to"}}</th></tr></thead><tbody data-software-organize-rows></tbody></table>
    </div>
    <nav class="software-organize-pages" data-software-organize-pages hidden><button class="ui basic button" type="button" data-software-organize-prev>{{ctx.Locale.Tr "repo.issues.previous"}}</button><span data-software-organize-page></span><button class="ui basic button" type="button" data-software-organize-next>{{ctx.Locale.Tr "repo.issues.next"}}</button></nav>
    <details data-software-organize-skipped hidden><summary></summary><p>{{ctx.Locale.Tr "software.organize_skipped_hint"}}</p><ul data-software-organize-skipped-items></ul></details>
   </section>
   <p data-software-organize-error role="alert"></p>
   <div class="software-dialog-buttons"><button class="ui basic button" type="button" data-software-organize-cancel>{{ctx.Locale.Tr "cancel"}}</button><button class="ui basic button" type="button" data-software-organize-preview>{{ctx.Locale.Tr "software.organize_preview"}}</button><button class="ui primary button" type="button" data-software-organize-apply disabled>{{ctx.Locale.Tr "software.organize_apply"}}</button></div>
  </dialog>
 </section>
</main>
{{template "base/footer" .}}
