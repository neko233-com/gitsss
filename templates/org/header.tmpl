{{template "workspace/sidebar" .}}
<header class="workspace-heading ui container">
 <div><h1>{{if .PageIsNews}}{{ctx.Locale.Tr "workspace.overview"}}{{else}}{{.Title}}{{end}}</h1></div>
 <div class="flex-text-block">
  {{if .PageIsNews}}{{template "org/team_filter" .}}{{end}}
  {{if .Org.Visibility.IsPrivate}}<span class="ui basic label">{{ctx.Locale.Tr "org.settings.visibility.private_shortname"}}</span>{{end}}
  {{if .Org.Visibility.IsLimited}}<span class="ui basic label">{{ctx.Locale.Tr "org.settings.visibility.limited_shortname"}}</span>{{end}}
  {{if .EnableFeed}}<a class="ui basic icon button" href="{{.Org.HomeLink}}.rss" aria-label="{{ctx.Locale.Tr "rss_feed"}}">{{svg "octicon-rss"}}</a>{{end}}
 </div>
</header>
{{if or .RenderedDescription .Org.Location .Org.Website .Org.Email}}<details class="ui container workspace-about"><summary>{{ctx.Locale.Tr "org.workspace.about"}}</summary>
 {{if .RenderedDescription}}<div class="render-content markup">{{.RenderedDescription}}</div>{{end}}
 {{if .Org.Location}}<p>{{svg "octicon-location"}} {{.Org.Location}}</p>{{end}}
 {{if .Org.Website}}<p><a target="_blank" rel="me noopener" href="{{.Org.Website}}">{{.Org.Website}}</a></p>{{end}}
 {{if and .IsSigned .Org.Email}}<p><a href="mailto:{{.Org.Email}}">{{.Org.Email}}</a></p>{{end}}
</details>{{end}}
