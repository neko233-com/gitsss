{{template "admin/layout_head" (dict "ctxData" . "pageClass" "admin actions")}}
	<div class="admin-setting-content">
	{{if eq .PageType "runners"}}
		<div class="ui segment admin-builtin-runner-card">
			<div class="ui header">{{ctx.Locale.Tr "actions.runners.builtin.title"}}</div>
			<p class="muted">{{ctx.Locale.Tr "actions.runners.builtin.description"}}</p>
			<div class="admin-builtin-runner-meta">
				<span class="ui {{if .BuiltinRunnerEnabled}}green{{else}}grey{{end}} label">
					{{if .BuiltinRunnerEnabled}}{{ctx.Locale.Tr "actions.runners.builtin.enabled"}}{{else}}{{ctx.Locale.Tr "actions.runners.builtin.disabled"}}{{end}}
				</span>
				<span>{{ctx.Locale.Tr "actions.runners.builtin.capacity"}}: {{.BuiltinRunnerCapacity}}</span>
				<span>{{ctx.Locale.Tr "actions.runners.builtin.labels"}}: {{StringUtils.Join .BuiltinRunnerLabels ", "}}</span>
			</div>
			<div class="admin-builtin-runner-actions">
				{{if not .BuiltinRunnerEnabled}}
					<span class="muted">{{ctx.Locale.Tr "actions.runners.builtin.config_disabled"}}</span>
				{{else if .BuiltinRunnerRunning}}
					<button class="ui basic button link-action" data-url="{{AppSubUrl}}/-/admin/actions/runners/builtin/restart" data-modal-confirm="{{ctx.Locale.Tr "actions.runners.builtin.restart_confirm"}}">{{ctx.Locale.Tr "actions.runners.builtin.restart"}}</button>
					<button class="ui basic red button link-action" data-url="{{AppSubUrl}}/-/admin/actions/runners/builtin/stop" data-modal-confirm="{{ctx.Locale.Tr "actions.runners.builtin.stop_confirm"}}">{{ctx.Locale.Tr "actions.runners.builtin.stop"}}</button>
				{{else}}
					<button class="ui primary button link-action" data-url="{{AppSubUrl}}/-/admin/actions/runners/builtin/start">{{ctx.Locale.Tr "actions.runners.builtin.start"}}</button>
				{{end}}
			</div>
		</div>
		{{template "shared/actions/runner_list" .}}
	{{end}}
	{{if eq .PageType "variables"}}
		{{template "shared/variables/variable_list" .}}
	{{end}}
	</div>
{{template "admin/layout_footer" .}}
